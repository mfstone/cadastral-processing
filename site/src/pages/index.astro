---
import '@fontsource-variable/source-serif-4';
import '../styles/viz.css';

const title = 'Montana Cadastral Analytics Engine';
const description = 'Where parcels are being created, who owns Montana, and what has actually been built — over 29 statewide cadastral vintages.';

/* Link previews need absolute URLs: a crawler resolves nothing relative to the
   page it fetched. `?v=` is a cache-buster, because LinkedIn, Slack and the rest
   cache a card per URL for days; bump it whenever the picture changes. PNG, not
   WebP, since WebP support among preview crawlers is still patchy. */
const SITE = 'https://cadastral-analytics.epistemegeospatial.com';
const CARD_VERSION = '2026-11-04';
const canonical = `${SITE}/`;
const card = `${SITE}/social-card.png?v=${CARD_VERSION}`;
const cardAlt = 'The Montana Cadastral Analytics Engine: a map of Montana shaded by township, beside '
  + 'the development ladder and absorption charts for the newest export.';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={title} />
  <meta property="og:image" content={card} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={cardAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={card} />
  <meta name="twitter:image:alt" content={cardAlt} />
  <link rel="icon" href="/favicon.svg" />
</head>
<body>
  <div id="boot">Loading 29 cadastral vintages…</div>

  <div id="app" hidden>
    <header>
      <h1>Montana Cadastral Analytics Engine</h1>
      <span class="sub" id="sub"></span>
      <div id="hdr-actions">
        <!-- The views, as one menu: each with a line on what it shows. -->
        <div id="viewmenu">
          <button id="views-btn" class="hbtn hbtn-strong" type="button" aria-haspopup="menu" aria-expanded="false"
                  aria-controls="nav"><span class="vm-k">View</span> <span id="views-current">Development</span>
            <span class="vm-caret" aria-hidden="true">▾</span></button>
          <nav id="nav" role="menu" aria-label="Views" hidden></nav>
        </div>
        <button id="reports-btn" class="hbtn" type="button" data-view="reports" aria-pressed="false"
                title="Six printable reports built from the same tables">Reports</button>
        <button id="about-btn" class="hbtn" type="button" data-view="about" aria-pressed="false">About</button>
        <span id="tourwrap">
          <button id="tour-btn" class="hbtn" type="button" hidden aria-expanded="false"
                  title="A guided tour of the application">Tutorial</button>
          <span id="tour-hint" role="status" hidden>New here? Take the two-minute tutorial.
            <button id="tour-hint-x" type="button" aria-label="Dismiss">&times;</button></span>
        </span>
        <button id="theme" class="hbtn" type="button" title="Toggle light / dark" aria-label="Toggle light or dark theme">◐</button>
        <button id="assist-toggle" class="hbtn" hidden aria-expanded="false" aria-controls="assist"
                title="Ask a question; the assistant sets the dashboard and answers from its tables">Ask</button>
      </div>
    </header>

    <!-- Filters in one row above the content. -->
    <div id="filters">
      <div id="timewrap">
        <label for="snap">Snapshot</label>
        <input id="snap" type="range" min="0" step="1" value="0" />
        <span id="snaplabel"></span>
        <span id="snapwarn" hidden aria-label="This vintage has a field that cannot be reported"
              style="color:var(--statute);font-weight:700;cursor:help">&#9888;</span>
      </div>
      <!-- On a phone the controls below the slider fold behind this. -->
      <button id="filters-more" type="button" aria-expanded="false" aria-controls="filters">Filters</button>
      <label for="level">Unit
        <select id="level">
          <option value="township" selected>PLSS township</option>
          <option value="county">County</option>
        </select>
      </label>
      <label for="measure">Measure
        <select id="measure">
          <option value="parcels" selected>Parcels</option>
          <option value="acres">Acres</option>
        </select>
      </label>
      <span id="originwrap" hidden>
        <label for="origin">Owner origin
          <select id="origin"></select>
        </label>
      </span>
      <span id="erawrap" hidden>
        <label for="era">Era
          <select id="era">
            <option value="all" selected>All</option>
            <option value="early">2003–2010</option>
            <option value="mid">2011–2019</option>
            <option value="late">2020–2026</option>
          </select>
        </label>
      </span>
      <label for="basemap">Basemap
        <select id="basemap">
          <option value="none" selected>Outlines only</option>
          <option value="montana">Montana (in-house)</option>
          <option value="positron">OpenStreetMap (external)</option>
        </select>
      </label>
      <label for="mask"><input id="mask" type="checkbox" checked /> Mask low coverage</label>
      <button id="clearsel" style="font:inherit;font-size:12px;padding:3px 9px;
              border:1px solid var(--axis);border-radius:5px;background:var(--surface-1);
              color:var(--ink-2);cursor:pointer">Clear selection</button>
    </div>

    <main>
      <div id="mapwrap">
        <div id="map" role="region" aria-label="Map of Montana"></div>
        <p id="map-desc" class="sr-only" aria-live="polite"></p>
        <!-- The body is rewritten with every view; the toggle stays. On a phone
             the explanatory notes are hidden until More is pressed. -->
        <div id="legend"><div id="legend-body"></div>
          <button id="legend-more" type="button" aria-expanded="false" aria-controls="legend-body">More</button></div>
        <details id="layers" open>
          <summary>Layers</summary>
          <label><input type="checkbox" id="lyr-parcels" checked /> Parcels <span class="hint">(above z10)</span></label>
          <label><input type="checkbox" id="lyr-townships" checked /> Township grid</label>
          <label><input type="checkbox" id="lyr-counties" checked /> County boundaries</label>
          <label><input type="checkbox" id="lyr-roads" checked /> Roads <span class="hint">(MDT, with names)</span></label>
          <label><input type="checkbox" id="lyr-buildings" checked /> Buildings <span class="hint">(lidar areas)</span></label>
          <hr />
          <label><input type="checkbox" id="lyr-reservations" /> <span style="border-bottom:2px solid var(--cat-2)">Reservations</span></label>
          <label><input type="checkbox" id="lyr-publiclands" /> <span style="border-bottom:3px solid var(--public-land)">Public lands</span> <span class="hint">(0.9 MB)</span></label>
          <label><input type="checkbox" id="lyr-cities" /> <span style="border-bottom:2px dashed var(--city-limit)">City limits</span></label>
          <div id="lyr-status" class="hint"></div>
        </details>
        <div id="parcelinfo" hidden></div>
      </div>
      <!-- On a phone the panel is a sheet over the map: drag or tap this to raise it. -->
      <button id="sheet-grip" type="button" aria-controls="panel"
              aria-label="Charts panel: drag up or press to show more, down to show the map"><span></span></button>
      <div id="panel"></div>
    </main>

    <!-- The assistant's drawer; filled by src/assistant/panel.js on first open,
         and shown at all only where /api/assistant/health answers. -->
    <aside id="assist" hidden aria-label="Assistant">
      <div class="assist-head">
        <h2>Ask about the map</h2>
        <button id="assist-new" type="button" title="Start a new conversation">New</button>
        <button id="assist-close" type="button" aria-label="Close the assistant">&times;</button>
      </div>
      <div id="assist-log" role="log" aria-live="polite" aria-relevant="additions"></div>
      <div id="assist-suggest" aria-label="Suggested questions"></div>
      <p id="assist-notice" role="status" tabindex="-1" hidden></p>
      <form id="assist-form">
        <textarea id="assist-q" rows="2" placeholder="Ask about Montana’s parcels, owners and housing…"
                  aria-label="Your question"></textarea>
        <div class="assist-actions">
          <button id="assist-send" type="submit">Ask</button>
          <button id="assist-stop" type="button" hidden>Stop</button>
        </div>
      </form>
      <p id="assist-privacy" class="hint"></p>
    </aside>
  </div>

  <script>
    import 'maplibre-gl/dist/maplibre-gl.css';
    import { boot } from '../lib/app.js';
    boot().catch((err) => {
      console.error(err);
      const b = document.getElementById('boot');
      if (b) b.textContent = `Could not load: ${err.message}`;
    });
  </script>
</body>
</html>
