  },
  "dependencies": {
    "astro": "^5.6.1",
    "hyparquet": "^1.17.1",
    "hyparquet-compressors": "1.1.2",
    "maplibre-gl": "^5.9.0"
  },
  "devDependencies": {
    "puppeteer-core": "^25.12.0"
  }
}
