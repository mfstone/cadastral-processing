# Cloudflare Pages headers.
#
# No external SCRIPTS: every dependency is bundled, so `script-src 'self'` stays
# absolute. That is the clause that matters -- a compromised CDN script is the
# realistic attack on a static site.
#
# The one external origin is tiles.openfreemap.org, serving the basemap (vector
# tiles via fetch, sprites and relief as images, glyph PBFs as fonts). It can
# execute nothing: it is reachable from connect-src, img-src and font-src only,
# never script-src, and the "Outlines only" basemap renders entirely from
# first-party data if it is ever unavailable.
#
# worker-src blob: is required by MapLibre, which parses vector tiles in a
# worker created from a blob URL.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tiles.openfreemap.org; font-src 'self' https://tiles.openfreemap.org; connect-src 'self' https://tiles.openfreemap.org; worker-src 'self' blob:; child-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# The data bundle is rebuilt as a set; revalidate until the directory is versioned.
/data/*
  Cache-Control: public, max-age=300, must-revalidate

# Astro fingerprints everything under _astro/, so it is immutable.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
